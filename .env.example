# Copia este archivo a .env.local y completa los valores.
# NUNCA commitees .env.local ni pongas claves secretas en variables NEXT_PUBLIC_*.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
# La clave publishable (o anon) es pública por diseño; la seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- n8n ---
# URL base de tu instancia n8n (local: docker compose; remota: tu dominio).
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# Secreto compartido (mínimo 32 caracteres) para firmar webhooks en ambos sentidos.
# Generar con: openssl rand -hex 32
N8N_WEBHOOK_SECRET=
